# RentHood configuration

# WhatsApp business/support number in international format, digits only.
VITE_WHATSAPP_NUMBER=919876543210

# Cashfree Payment Gateway credentials (server-side only — never expose these in the client)
# Create keys at https://merchant.cashfree.com/merchant/developers/keys
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2023-08-01

# Used by Cashfree to send the customer back after payment.
# For local development the request origin is used automatically.
PUBLIC_APP_URL=http://localhost:5173

# Optional: public URL for Cashfree payment webhooks
CASHFREE_WEBHOOK_URL=

# Optional API port (Vite proxies /api to 8787 by default)
PORT=8787
